# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
SANCTIONS_ENVIRONMENT=dev
SANCTIONS_DATABASE_URL=postgresql://sanctions:sanctions@localhost:5432/sanctions
SANCTIONS_ANALYST_DATABASE_URL=postgresql://sanctions_analyst:sanctions_analyst@localhost:5432/sanctions
# Password assigned to the read-only analyst role by migration 0002 (dev/test convenience; in prod a DBA sets it)
SANCTIONS_ANALYST_PASSWORD=sanctions_analyst
SANCTIONS_USER_AGENT=cb-sc-agent/0.1 (sanctions list ingestion; contact: compliance-engineering@yourcompany.example)
SANCTIONS_AGENT_MODEL=gpt-5-mini
SANCTIONS_AGENT_DAILY_BUDGET_USD=2.0
SANCTIONS_COMPANIES_HOUSE_API_KEY=
SANCTIONS_ALERT_WEBHOOK_URL=
SANCTIONS_AUTH_MODE=basic
# user:password:role,...  (roles: viewer, operator, reviewer, admin). Use proxy mode + SSO in production.
SANCTIONS_UI_USERS=admin:change-me:admin
